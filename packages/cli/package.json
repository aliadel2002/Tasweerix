{
  "name": "@tasweerix/cli",
  "version": "0.1.0",
  "type": "module",
  "description": "Tasweerix command line: render videos, stills and audio; run the studio.",
  "license": "MIT",
  "bin": {
    "tasweerix": "./bin/tasweerix.mjs"
  },
  "main": "./dist/main.js",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js",
      "require": "./dist/main.cjs",
      "default": "./dist/main.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@tasweerix/core": "workspace:*",
    "@tasweerix/media": "workspace:*",
    "@tasweerix/render": "workspace:*",
    "tasweerix": "workspace:*",
    "commander": "^12.1.0",
    "esbuild": "^0.24.0",
    "playwright-core": "1.56.1",
    "tsx": "^4.19.2",
    "ws": "^8.18.0",
    "@tasweerix/audio": "workspace:*",
    "@tasweerix/illustrate": "workspace:*",
    "@tasweerix/type": "workspace:*",
    "@tasweerix/smart": "workspace:*",
    "@tasweerix/codemod": "workspace:*",
    "@tasweerix/interchange": "workspace:*",
    "@tasweerix/vision": "workspace:*",
    "@tasweerix/ai": "workspace:*"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13"
  },
  "types": "./dist/main.d.ts",
  "files": [
    "dist",
    "bin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/main.ts --format esm --dts --out-dir dist --clean",
    "prepublishOnly": "pnpm run build"
  }
}
