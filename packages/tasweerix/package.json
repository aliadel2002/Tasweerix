{
  "name": "tasweerix",
  "version": "0.1.0",
  "type": "module",
  "description": "Code-first video, audio, photo, motion-graphics and illustration engine.",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@tasweerix/core": "workspace:*",
    "@tasweerix/render": "workspace:*",
    "@tasweerix/media": "workspace:*",
    "@tasweerix/audio": "workspace:*",
    "@tasweerix/image": "workspace:*",
    "@tasweerix/type": "workspace:*",
    "@tasweerix/motion": "workspace:*",
    "@tasweerix/illustrate": "workspace:*",
    "@tasweerix/smart": "workspace:*",
    "@tasweerix/vision": "workspace:*",
    "@tasweerix/3d": "workspace:*",
    "@tasweerix/ai": "workspace:*",
    "@tasweerix/interchange": "workspace:*"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "prepublishOnly": "pnpm run build"
  }
}
