<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fcpxml>
<fcpxml version="1.10">
  <resources>
    <format id="r1" name="FFVideoFormat720p25" frameDuration="100/2500s" width="1280" height="720"/>
    <asset id="r2" name="A Roll" start="3600s" duration="20s" hasVideo="1" hasAudio="1" format="r1" audioSources="1" audioChannels="2" audioRate="48000">
      <media-rep kind="original-media" src="file:///Volumes/Media/A%20Roll.mov"/>
    </asset>
    <asset id="r3" name="B" start="0s" duration="30s" hasVideo="1" hasAudio="1" format="r1">
      <media-rep kind="original-media" src="file:///Volumes/Media/B.mov"/>
    </asset>
    <asset id="r4" name="logo" start="0s" duration="0s" hasVideo="1" format="r1">
      <media-rep kind="original-media" src="file:///Volumes/Media/logo.png"/>
    </asset>
    <asset id="r5" name="Song" start="0s" duration="120s" hasAudio="1" audioSources="1" audioChannels="2" audioRate="44100">
      <media-rep kind="original-media" src="file:///Volumes/Media/song.m4a"/>
    </asset>
    <effect id="r6" name="Basic Title" uid=".../Titles.localized/Bumper:Opener.localized/Basic Title.localized/Basic Title.moti"/>
    <media id="r7" name="Compound">
      <sequence format="r1" duration="6s">
        <spine>
          <asset-clip ref="r3" offset="0s" name="B inner 1" start="10s" duration="3s"/>
          <asset-clip ref="r3" offset="3s" name="B inner 2" start="20s" duration="3s"/>
        </spine>
      </sequence>
    </media>
  </resources>
  <library>
    <event name="Event">
      <project name="Hand Made">
        <sequence format="r1" duration="20s" tcStart="3600s" tcFormat="NDF" audioLayout="stereo" audioRate="48k">
          <spine>
            <asset-clip ref="r2" offset="3600s" name="A1" start="3602s" duration="5s" tcFormat="NDF">
              <marker start="3603s" duration="1/25s" value="Beat"/>
              <title ref="r6" lane="1" offset="3603s" name="Hello - Basic Title" start="0s" duration="2s">
                <text><text-style ref="ts1">Hello</text-style></text>
                <text-style-def id="ts1"><text-style font="Helvetica" fontSize="63"/></text-style-def>
              </title>
            </asset-clip>
            <transition name="Cross Dissolve" offset="3604s" duration="2s"/>
            <asset-clip ref="r3" offset="3605s" name="B1" start="5s" duration="4s">
              <spine lane="1" offset="6s">
                <video ref="r4" offset="0s" name="logo" start="0s" duration="1s"/>
                <asset-clip ref="r3" offset="1s" name="B2" start="0s" duration="1s"/>
              </spine>
              <asset-clip ref="r5" lane="-1" offset="5s" name="Song" start="30s" duration="4s">
                <adjust-volume amount="-9dB"/>
              </asset-clip>
            </asset-clip>
            <ref-clip ref="r7" offset="3609s" name="Compound" start="1s" duration="4s"/>
            <asset-clip ref="r3" offset="3613s" name="Slow" start="0s" duration="4s">
              <timeMap>
                <timept time="0s" value="0s" interp="linear"/>
                <timept time="4s" value="2s" interp="linear"/>
              </timeMap>
              <filter-video ref="r8" name="Gaussian Blur"/>
            </asset-clip>
            <gap name="Gap" offset="3617s" start="0s" duration="3s"/>
          </spine>
        </sequence>
      </project>
    </event>
  </library>
</fcpxml>
