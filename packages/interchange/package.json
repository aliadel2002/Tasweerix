{
  "name": "@tasweerix/interchange",
  "version": "0.1.0",
  "type": "module",
  "description": "Tasweerix timeline interchange: import and export edits as FCPXML (Final Cut Pro, DaVinci Resolve), OpenTimelineIO, FCP7 XML (Premiere Pro) and CMX 3600 EDL.",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@tasweerix/core": "workspace:*",
    "@tasweerix/render": "workspace:*"
  },
  "module": "./dist/index.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/node.ts --format esm,cjs --dts --out-dir dist --clean",
    "prepublishOnly": "pnpm run build"
  }
}
