{
  "name": "@tasweerix/illustrate",
  "version": "0.1.0",
  "type": "module",
  "description": "Tasweerix vector illustration: path builder, booleans and offsets, generative art tools, SVG import/export.",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@tasweerix/core": "workspace:*",
    "polygon-clipping": "^0.15.7"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "prepublishOnly": "pnpm run build"
  }
}
