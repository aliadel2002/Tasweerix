{
  "name": "@tasweerix/codemod",
  "version": "0.1.0",
  "type": "module",
  "description": "Tasweerix two-way editing: maps studio GUI edits to formatting-preserving source code changes.",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@babel/parser": "^7.26.3",
    "recast": "^0.23.9",
    "source-map-js": "^1.2.1"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "prepublishOnly": "pnpm run build"
  }
}
