{
  "name": "@tasweerix/vision",
  "version": "0.1.0",
  "type": "module",
  "description": "Tasweerix computer vision: video stabilization and point tracking in pure TypeScript (Shi–Tomasi corners, pyramidal Lucas–Kanade flow, RANSAC).",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts"
  },
  "dependencies": {
    "@tasweerix/core": "workspace:*",
    "@tasweerix/media": "workspace:*"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/node.ts --format esm --dts --clean",
    "prepublishOnly": "pnpm run build"
  }
}
