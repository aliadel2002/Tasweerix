{
  "name": "@tasweerix/type",
  "version": "0.1.0",
  "type": "module",
  "description": "Tasweerix typography: HarfBuzz shaping, Unicode bidi, glyph-path text for kinetic typography in any script (Arabic, Hebrew, Devanagari …).",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@tasweerix/core": "workspace:*",
    "@tasweerix/render": "workspace:*",
    "bidi-js": "^1.0.3",
    "harfbuzzjs": "^0.4.0"
  },
  "imports": {
    "#hbwasm": {
      "tasweerix-bundle": "./src/wasm-static.ts",
      "browser": "./src/wasm-static.ts",
      "default": "./src/wasm-node.ts"
    }
  },
  "module": "./dist/index.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build"
  }
}
