{
  "name": "@tasweerix/type",
  "version": "0.1.0",
  "type": "module",
  "description": "Tasweerix typography: HarfBuzz shaping, Unicode bidi, glyph-path text for kinetic typography in any script (Arabic, Hebrew, Devanagari …).",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@tasweerix/core": "workspace:*",
    "@tasweerix/render": "workspace:*",
    "bidi-js": "^1.0.3",
    "harfbuzzjs": "^0.4.0"
  },
  "imports": {
    "#hbwasm": {
      "tasweerix-bundle": "./src/wasm-static.ts",
      "browser": "./src/wasm-static.ts",
      "default": "./src/wasm-node.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "imports": {
      "#hbwasm": {
        "tasweerix-bundle": "./dist/wasm-static.js",
        "browser": "./dist/wasm-static.js",
        "default": "./dist/wasm-node.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build"
  }
}
