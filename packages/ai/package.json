{
  "name": "@tasweerix/ai",
  "version": "0.1.0",
  "type": "module",
  "description": "Tasweerix AI: Claude-powered generation, vision and a code-editing assistant, speech-to-text captions and transcript-based editing, with pluggable providers. Results are cached so renders stay deterministic.",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@tasweerix/core": "workspace:*",
    "@tasweerix/media": "workspace:*"
  },
  "files": [
    "dist",
    "docs"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build"
  }
}
