{
  "name": "@tasweerix/3d",
  "version": "0.1.0",
  "type": "module",
  "description": "Tasweerix 3D: meshes, extruded paths and Arabic-capable 3D text, glTF/OBJ models, PBR materials, lights and shadows, animated cameras and 2D layers in 3D space, rendered with WebGL2.",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@tasweerix/core": "workspace:*",
    "@tasweerix/render": "workspace:*",
    "@tasweerix/type": "workspace:*"
  },
  "devDependencies": {
    "@tasweerix/media": "workspace:*"
  },
  "module": "./dist/index.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --out-dir dist --clean",
    "prepublishOnly": "pnpm run build"
  }
}
