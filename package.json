{
  "name": "tasweerix-monorepo",
  "private": true,
  "type": "module",
  "description": "Tasweerix — a code-first engine for video, audio, photo, motion graphics and illustration.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "gpu-check": "node scripts/gpu-check.mjs",
    "tasweerix": "node packages/cli/bin/tasweerix.mjs",
    "studio": "node packages/cli/bin/tasweerix.mjs studio examples/promo",
    "format": "prettier --write .",
    "examples": "bash scripts/check-examples.sh",
    "build:plugin-host": "cmake -S native/plugin-host -B native/plugin-host/build && cmake --build native/plugin-host/build --config Release -j 4",
    "build": "pnpm -r build",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.6.3",
    "vitest": "^2.1.8",
    "tsup": "^8.5.0",
    "@changesets/cli": "^2.29.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
